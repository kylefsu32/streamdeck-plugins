{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Claude Usage",
	"Version": "0.1.0.0",
	"Author": "kylefsu32",
	"URL": "https://github.com/kylefsu32/streamdeck-plugins",
	"Actions": [
		{
			"Name": "Usage Rings",
			"UUID": "com.kylefsu.claude-usage.rings",
			"Icon": "imgs/actions/rings/icon",
			"Tooltip": "Activity rings for the rolling Claude Code session and week.",
			"PropertyInspectorPath": "ui/rings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/rings/key",
					"TitleAlignment": "bottom",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Burn Rate",
			"UUID": "com.kylefsu.claude-usage.burn",
			"Icon": "imgs/actions/burn/icon",
			"Tooltip": "Current spend rate and projected time until the session ceiling.",
			"PropertyInspectorPath": "ui/burn.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/burn/key",
					"TitleAlignment": "bottom",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "Claude Usage",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"Description": "Claude Code usage as Apple Watch style activity rings, computed locally from your own transcripts.",
	"Icon": "imgs/plugin/plugin",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.kylefsu.claude-usage"
}
