{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "System Vitals",
	"Version": "0.1.0.0",
	"Author": "kylefsu32",
	"URL": "https://github.com/kylefsu32/streamdeck-plugins",
	"Actions": [
		{
			"Name": "CPU",
			"UUID": "com.kylefsu.system-vitals.cpu",
			"Icon": "imgs/actions/cpu/icon",
			"Tooltip": "Live CPU usage: total, busiest core, every core, or load average.",
			"PropertyInspectorPath": "ui/cpu.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/cpu/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Memory",
			"UUID": "com.kylefsu.system-vitals.memory",
			"Icon": "imgs/actions/memory/icon",
			"Tooltip": "Memory used, memory pressure, and swap, counted the way Activity Monitor does.",
			"PropertyInspectorPath": "ui/memory.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/memory/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "GPU",
			"UUID": "com.kylefsu.system-vitals.gpu",
			"Icon": "imgs/actions/gpu/icon",
			"Tooltip": "Apple Silicon GPU usage and GPU memory in use.",
			"PropertyInspectorPath": "ui/gpu.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/gpu/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Disk",
			"UUID": "com.kylefsu.system-vitals.disk",
			"Icon": "imgs/actions/disk/icon",
			"Tooltip": "Free space on any volume, or live read/write speed.",
			"PropertyInspectorPath": "ui/disk.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/disk/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Network",
			"UUID": "com.kylefsu.system-vitals.network",
			"Icon": "imgs/actions/network/icon",
			"Tooltip": "Download and upload speed per adapter, plus totals for the last minute, hour, and day.",
			"PropertyInspectorPath": "ui/network.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/network/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Ping",
			"UUID": "com.kylefsu.system-vitals.ping",
			"Icon": "imgs/actions/ping/icon",
			"Tooltip": "Round-trip time and packet loss to any host.",
			"PropertyInspectorPath": "ui/ping.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ping/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Uptime & Battery",
			"UUID": "com.kylefsu.system-vitals.system",
			"Icon": "imgs/actions/system/icon",
			"Tooltip": "How long the Mac has been up, or battery charge and time left.",
			"PropertyInspectorPath": "ui/system.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/system/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Top Apps",
			"UUID": "com.kylefsu.system-vitals.top",
			"Icon": "imgs/actions/top/icon",
			"Tooltip": "The apps using the most CPU or memory right now.",
			"PropertyInspectorPath": "ui/top.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/top/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "App Watch",
			"UUID": "com.kylefsu.system-vitals.app",
			"Icon": "imgs/actions/app/icon",
			"Tooltip": "CPU or memory for one app you pick. Fades out when the app isn't running.",
			"PropertyInspectorPath": "ui/app.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/app/key",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "System Vitals",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"Description": "Live Mac system stats on your keys: CPU, memory, GPU, disk, network, ping, battery, and the apps using the most.",
	"Icon": "imgs/plugin/plugin",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.kylefsu.system-vitals"
}
