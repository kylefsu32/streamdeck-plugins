{
	"name": "system-vitals-streamdeck",
	"version": "0.1.0",
	"private": true,
	"description": "Stream Deck plugin showing live CPU, memory, GPU, disk, network, and process stats on keys.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.kylefsu.system-vitals\"",
		"icons": "node tools/make-icons.mjs",
		"preview": "rollup -c && SYSTEM_VITALS_NO_PERSIST=1 node dist/preview.mjs",
		"probe": "rollup -c && node dist/probe.mjs",
		"test": "rollup -c && SYSTEM_VITALS_NO_PERSIST=1 node --test dist/test.mjs",
		"validate": "streamdeck validate com.kylefsu.system-vitals.sdPlugin"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.0",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.2",
		"@tsconfig/node20": "^20.1.4",
		"@types/node": "22.13.0",
		"rollup": "^4.32.1",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.0.1"
	}
}
